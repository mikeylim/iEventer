# ── Core APIs ─────────────────────────────────────
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the default Gemini 3.5 Flash Lite model for all AI features.
# Feature-specific overrides are also supported: GEMINI_SUGGESTIONS_MODEL,
# GEMINI_ROUTE_MODEL, and GEMINI_DAILY_PICK_MODEL.
GEMINI_MODEL=gemini-3.5-flash-lite

# Eventbrite private token: https://www.eventbrite.com/platform/api-keys
EVENTBRITE_API_KEY=your_eventbrite_private_token_here

# Geoapify Places + geocoding: https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# ── Database (Supabase Postgres) ──────────────────
# Supabase Dashboard → Project Settings → Database → Connection String (URI)
# Replace [YOUR-PASSWORD] with your database password
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── NextAuth ──────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here
# For local dev, keep as http://localhost:3000. Update for prod.
NEXTAUTH_URL=http://localhost:3000

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Email (Resend) ────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=hello@yourdomain.com

# ── Cron ──────────────────────────────────────────
# Shared secret for the /api/cron/daily-picks endpoint.
# Generate with: openssl rand -base64 32
CRON_SECRET=your_cron_secret_here
